{
    "$schema": "https://turbo.build/schema.json",
    "globalEnv": ["NETWORK", "NODE_ENV", "PORT"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["build/**", "dist/**", ".next/**", ".vitepress/dist/**"]
        },
        "clean": {
            "cache": false
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {},
        "start": {
            "dependsOn": ["^build"]
        }
    }
}
