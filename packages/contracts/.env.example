# Loaded automatically by forge from packages/contracts/.env

# RPC endpoints used by `forge script --rpc-url <network>` (see foundry.toml)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
OPTIMISM_RPC_URL=https://mainnet.optimism.io
OPTIMISM_SEPOLIA_RPC_URL=https://sepolia.optimism.io
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Etherscan V2 API key, valid for every supported chain
ETHERSCAN_API_KEY=

# Deployer keystore, created with `cast wallet import <name> --interactive`
ETH_KEYSTORE_ACCOUNT=
