{
    "name": "@sunodo/contracts",
    "version": "0.10.0",
    "license": "Apache-2.0",
    "scripts": {
        "build": "forge build && bun scripts/export-artifacts.ts",
        "clean": "forge clean && rm -rf export/artifacts",
        "deploy": "forge script script/Deploy.s.sol --broadcast --verify",
        "deploy:arbitrum": "bun run deploy --rpc-url arbitrum",
        "deploy:arbitrum_sepolia": "bun run deploy --rpc-url arbitrum_sepolia",
        "deploy:base": "bun run deploy --rpc-url base",
        "deploy:base_sepolia": "bun run deploy --rpc-url base_sepolia",
        "deploy:mainnet": "bun run deploy --rpc-url mainnet",
        "deploy:mainnets": "bun run deploy:arbitrum && bun run deploy:base && bun run deploy:mainnet && bun run deploy:optimism",
        "deploy:optimism": "bun run deploy --rpc-url optimism",
        "deploy:optimism_sepolia": "bun run deploy --rpc-url optimism_sepolia",
        "deploy:sepolia": "bun run deploy --rpc-url sepolia",
        "deploy:testnet": "bun run deploy:arbitrum_sepolia && bun run deploy:base_sepolia && bun run deploy:optimism_sepolia && bun run deploy:sepolia",
        "doc": "forge doc",
        "fmt": "forge fmt",
        "fmt:check": "forge fmt --check",
        "install:deps": "forge soldeer install",
        "prepack": "bun run build",
        "test": "forge test"
    },
    "files": [
        "src",
        "broadcast/*/*/run-latest.json",
        "deployments/*/*.json",
        "deployments/*/.chainId",
        "export",
        "foundry.toml",
        "remappings.txt",
        "soldeer.lock"
    ]
}
