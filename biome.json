{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    "files": {
        "includes": ["**", "!**/artifacts/**", "!**/dist/**", "!**/*.svg"]
    },
    "formatter": {
        "enabled": false
    },
    "assist": { "actions": { "source": { "organizeImports": "off" } } },
    "linter": {
        "enabled": true,
        "rules": { "preset": "recommended" }
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    }
}
